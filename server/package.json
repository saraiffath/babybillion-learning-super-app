{
  "name": "@babybillion/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "8.5.0",
    "@fastify/jwt": "7.2.4",
    "@fastify/multipart": "6.0.1",
    "@fastify/static": "6.12.0",
    "@prisma/client": "^5.9.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "fastify": "^4.29.1",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.16",
    "prisma": "^5.9.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}